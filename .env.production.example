# Copy to .env.production and fill in real values.
# docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Public origin used for invite links and QR codes. Must match how guests open the app.
FRONTEND_URL=https://photos.example.com
# Caddy site address: your hostname for HTTPS, or `localhost` / `:80` for an HTTP dry run.
SITE_ADDRESS=photos.example.com
COOKIE_SECURE=true

POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 32
SESSION_SECRET=
INVITATION_TOKEN_HASH_SECRET=
# 64 hex characters (32 bytes): openssl rand -hex 32
INVITATION_TOKEN_ENCRYPTION_KEY=

# Created on first boot only, when the admins table is empty.
ADMIN_USERNAME=wedding
ADMIN_PASSWORD=

MAX_FILE_SIZE=10485760
MAX_GALLERY_PHOTOS=30
TOP_N=10
